# Copy to /etc/h5e-lobby.env. Environment first, file second (shared/config.ts): anything
# set here wins over config.json, and anything set in neither takes the default.

# Advertised only: the address the game is told to connect to. It goes into the
# `[Servers]` ini and into the endpoints a room hands out, and NO socket is bound to it —
# so it has to be an address the game can actually dial, LAN or public.
H5E_HOST=127.0.0.1

# What the gateway, the web and the relay bind. Every interface by default, because a
# second machine has to be able to reach them. The core is deliberately not here: it binds
# loopback and refuses anything else, so moving this cannot publish it.
H5E_BIND=0.0.0.0

# Where the game asks for its server list (its http_proxy points here).
H5E_HTTP_PORT=8080

# The core's internal API. Loopback only, and that is not a convention — the core refuses
# to listen anywhere else, so nothing outside the host can reach it and nothing on the hop
# authenticates. There is no token here any more: it defaulted to a value written in the
# repository, which is a lock whose key everybody has.
H5E_CORE_PORT=40100
H5E_CORE_URL=ws://127.0.0.1:40100/core

# The browser lobby, and the relay agents connect to.
H5E_WEB_PORT=8081
H5E_RELAY_PORT=40200

# Paths, relative to the working directory unless absolute.
H5E_DATABASE=data/lobby.db
H5E_LOG_DIR=logs
