[Unit]
Description=h5e-lobby relay — carries game datagrams between agents
Documentation=file:/opt/h5e-lobby/docs/ARCHITECTURE.md
After=network-online.target h5e-core.service
Wants=network-online.target h5e-core.service
PartOf=h5e.target

[Service]
Type=simple
User=h5e
Group=h5e
WorkingDirectory=/opt/h5e-lobby
EnvironmentFile=-/etc/h5e-lobby.env
ExecStart=/usr/bin/node services/relay.ts
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/h5e-lobby/logs

[Install]
WantedBy=h5e.target
