# Copy to /etc/h5e-lobby.env. Environment first, file second (src/config.ts): anything
# set here wins over config.json, and anything set in neither takes the default.

# The address the services bind, and the one the game is told to connect to. On a host
# reached from outside this is the public one — the game must be able to dial it.
H5E_HOST=127.0.0.1

# Where the game asks for its server list (its http_proxy points here).
H5E_HTTP_PORT=8080

# The core's internal API. Loopback only: nothing outside the host has any business here.
H5E_CORE_PORT=40100
H5E_CORE_URL=ws://127.0.0.1:40100/core
# Change this. It is what the other three present to the core.
H5E_CORE_TOKEN=change-me

# The browser lobby, and the relay agents connect to.
H5E_WEB_PORT=8081
H5E_RELAY_PORT=40200

# Paths, relative to the working directory unless absolute.
H5E_DATABASE=data/lobby.db
H5E_LOG_DIR=logs
