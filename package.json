{
  "name": "h5e-lobby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Our own online services for Heroes of Might and Magic V (Tribes of the East) — the Ubi.com lobby the game can no longer reach",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node tools/fleet.ts",
    "fleet": "node tools/fleet.ts",
    "core": "node services/core/main.ts",
    "gateway": "node services/gateway/main.ts",
    "net-server": "node services/gateway/main.ts",
    "web": "node services/web/main.ts",
    "relay": "node services/relay/main.ts",
    "test": "node tools/test-net.ts && node tools/test-services.ts",
    "test-net": "node tools/test-net.ts",
    "test-services": "node tools/test-services.ts",
    "net-decode": "node tools/net-decode.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
