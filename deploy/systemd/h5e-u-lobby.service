[Unit]
Description=h5e-lobby u-lobby tunnel — carries a game's own u-lobby sockets over one WebSocket
Documentation=file:/opt/h5e-lobby/docs/ARCHITECTURE.md
# The gateway and not the core: every stream this opens lands on the gateway's TCP port,
# and a tunnel that is up before the u-lobby services are just refuses connections until they are.
After=network-online.target h5e-gateway.service
Wants=network-online.target h5e-gateway.service
PartOf=h5e.target

[Service]
Type=simple
User=h5e
Group=h5e
WorkingDirectory=/opt/h5e-lobby
EnvironmentFile=-/etc/h5e-lobby.env
ExecStart=/usr/bin/node services/u-lobby/main.ts
Restart=on-failure
RestartSec=2

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/opt/h5e-lobby/logs

[Install]
WantedBy=h5e.target
